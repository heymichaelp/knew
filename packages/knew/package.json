{
  "name": "@popjoker/knew",
  "version": "0.2.1",
  "description": "The attention engine: understanding by dimension, the next direction, and the whole pipeline in your process with your own model key, or on the device. One runtime dependency: zod.",
  "license": "MIT",
  "homepage": "https://knew.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heymichaelp/knew.git",
    "directory": "packages/knew"
  },
  "bugs": {
    "url": "https://github.com/heymichaelp/knew/issues"
  },
  "keywords": [
    "attention",
    "intelligence",
    "facts",
    "bi-temporal",
    "lens",
    "episodes",
    "knowledge",
    "people",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "default": "./dist/anthropic.js"
    },
    "./apple": {
      "types": "./dist/apple.d.ts",
      "default": "./dist/apple.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prompts",
    "LICENSE",
    "README.md",
    "ADOPTING.md",
    "CHANGELOG.md",
    "apple"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "prompts": "node scripts/embed-prompts.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run prompts && npm run build && npm test"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.133.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
