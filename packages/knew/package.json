{
  "name": "@popjoker/knew",
  "version": "0.1.1",
  "description": "The people-intelligence engine's pure core: the contract, the lenses, the brief, the reconciliation plan, the prompt text, and the HTTP client. No database, no model, no React.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heymichaelp/knewpeople.git",
    "directory": "packages/knew"
  },
  "keywords": [
    "people",
    "intelligence",
    "memory",
    "facts",
    "bi-temporal",
    "lens",
    "knewpeople"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prompts",
    "README.md",
    "ADOPTING.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "prompts": "node scripts/embed-prompts.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run prompts && npm run build && npm test"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
